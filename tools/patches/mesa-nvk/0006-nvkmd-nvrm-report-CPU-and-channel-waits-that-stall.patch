From 9747321834e0b8feed222c1717da9490cd62a06b Mon Sep 17 00:00:00 2001
From: Techniix <Techniix@users.noreply.github.com>
Date: Fri, 6 Nov 2026 23:34:37 -0500
Subject: [PATCH] nvkmd/nvrm: report CPU and channel waits that stall for
 seconds

A wait that never completes now says so on stderr after 3 s, and every
5 s after that, without changing the wait itself:

- sync waits (fences, semaphores): each sync's kind, the value waited
  for, and its value/submit_seq/wait_seq/reset_mark counters, so a lost
  signal or a binary-semaphore pairing mismatch is visible;
- channel waits (cmdbuf slot recycle, channel sync): the fence needed,
  the completed and submitted fences, and GPGet/GPPut, which shows
  whether the GPU is parked on a semaphore acquire.
---
 .../vulkan/nvkmd/nvrm/nvkmd_nvrm_ctx.c        | 31 ++++++++++++++
 .../vulkan/nvkmd/nvrm/nvkmd_nvrm_sync.c       | 41 +++++++++++++++++++
 2 files changed, 72 insertions(+)

diff --git a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_ctx.c b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_ctx.c
index cbf6475..f6ede79 100644
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_ctx.c
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_ctx.c
@@ -21,6 +21,7 @@
 #include "util/u_memory.h"
 #include "util/u_dynarray.h"
 #include "util/macros.h"
+#include "util/os_time.h"
 #include "nv_push_clc36f.h"
 
 #include "class/cl0002.h" // NV01_CONTEXT_DMA
@@ -70,6 +71,22 @@ chan_completed(struct nvkmd_nvrm_channel *chan)
 	return *(volatile uint64_t *)chan->sem->map;
 }
 
+/* Report a channel wait that has run for seconds: the fence it needs, what
+ * the GPU has completed, and where the GPFIFO stands. GPGet stuck short of
+ * GPPut with no RC error usually means the GPU is parked on a semaphore
+ * acquire whose signal never came. */
+static void
+chan_report_stuck(struct nvkmd_nvrm_channel *chan, const char *what,
+                  uint64_t target, uint64_t waited_ns)
+{
+	KeplerBControlGPFifo *userD = chan->userD->map;
+	fprintf(stderr, "nvk/nvrm: %s waiting %.1f s for fence %" PRIu64
+	        ": completed %" PRIu64 ", submitted %" PRIu64
+	        ", GPGet %u GPPut %u\n",
+	        what, waited_ns / 1e9, target, chan_completed(chan), chan->wSeq,
+	        (unsigned)userD->GPGet, (unsigned)userD->GPPut);
+}
+
 /* True once RM has reported a robust-channel error on this channel. */
 static bool
 chan_check_error(struct nvkmd_nvrm_channel *chan)
@@ -349,11 +366,18 @@ nvrm_channel_submit(struct nvkmd_nvrm_dev *dev,
    chan->cmdBufCurSlot = (chan->cmdBufCurSlot + 1) % NVRM_CTX_CMDBUF_SLOTS;
 
    VkResult result = VK_SUCCESS;
+   const uint64_t wait_start = os_time_get_nano();
+   uint64_t next_report = wait_start + 3000000000ull;
    while (chan_completed(chan) < chan->cmdBufSlotFence[chan->cmdBufCurSlot]) {
       if (chan_check_error(chan)) {
          result = vk_error(log_obj, VK_ERROR_DEVICE_LOST);
          break;
       }
+      uint64_t now = os_time_get_nano();
+      if (now >= next_report) {
+         chan_report_stuck(chan, "cmdbuf slot recycle", chan->cmdBufSlotFence[chan->cmdBufCurSlot], now - wait_start);
+         next_report = now + 5000000000ull;
+      }
       struct pollfd pfd = { .fd = chan->osEvent, .events = POLLIN | POLLPRI };
       poll(&pfd, 1, 1000);
    }
@@ -367,9 +391,16 @@ nvrm_channel_submit(struct nvkmd_nvrm_dev *dev,
 static VkResult
 nvrm_channel_sync(struct nvkmd_nvrm_channel *chan, struct vk_object_base *log_obj)
 {
+   const uint64_t wait_start = os_time_get_nano();
+   uint64_t next_report = wait_start + 3000000000ull;
    while (chan_completed(chan) < chan->wSeq) {
       if (chan_check_error(chan))
          return vk_error(log_obj, VK_ERROR_DEVICE_LOST);
+      uint64_t now = os_time_get_nano();
+      if (now >= next_report) {
+         chan_report_stuck(chan, "channel sync", chan->wSeq, now - wait_start);
+         next_report = now + 5000000000ull;
+      }
       struct pollfd pfd = { .fd = chan->osEvent, .events = POLLIN | POLLPRI };
       poll(&pfd, 1, 1000);
    }
diff --git a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_sync.c b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_sync.c
index 9b0ab53..6d47501 100644
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_sync.c
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_sync.c
@@ -9,6 +9,8 @@
 #include <unistd.h>
 #include <poll.h>
 #include <stdlib.h>
+#include <stdio.h>
+#include <inttypes.h>
 
 #include "vk_log.h"
 #include "nvk_device.h"
@@ -552,6 +554,38 @@ sync_event_release(struct nvkmd_nvrm_dev *dev, int fd, NvHandle hEvent)
    simple_mtx_unlock(&dev->sync_mutex);
 }
 
+/* A CPU wait that runs for seconds is almost always a lost signal. Say which
+ * sync it is and where its counters stand, so a hang can be diagnosed from the
+ * app's stderr instead of a debugger. Printed after STUCK_FIRST_NS and then
+ * every STUCK_EVERY_NS; the wait itself carries on unchanged. */
+#define STUCK_FIRST_NS (3ull * 1000000000ull)
+#define STUCK_EVERY_NS (5ull * 1000000000ull)
+
+static void
+sync_wait_report_stuck(const struct vk_sync_wait *waits, uint32_t wait_count,
+                       enum vk_sync_wait_flags wait_flags, uint64_t waited_ns)
+{
+   fprintf(stderr, "nvk/nvrm: CPU wait not satisfied after %.1f s "
+           "(%u sync%s, %s%s)\n",
+           waited_ns / 1e9, wait_count, wait_count == 1 ? "" : "s",
+           (wait_flags & VK_SYNC_WAIT_ANY) ? "any" : "all",
+           (wait_flags & VK_SYNC_WAIT_PENDING) ? ", pending" : "");
+   for (uint32_t i = 0; i < wait_count; i++) {
+      struct nvkmd_nvrm_sync *sync = to_nvkmd_nvrm_sync(waits[i].sync);
+      struct nvrm_sync_data *d = sync_data(sync);
+      fprintf(stderr, "nvk/nvrm:   [%u] %p %s wait_value %" PRIu64
+              ": value %" PRIu64 " submit_seq %" PRIu64
+              " wait_seq %" PRIu64 " reset_mark %" PRIu64 "\n",
+              i, (void *)sync,
+              sync_is_timeline(waits[i].sync) ? "timeline" : "binary",
+              waits[i].wait_value,
+              __atomic_load_n(&d->value, __ATOMIC_ACQUIRE),
+              __atomic_load_n(&d->submit_seq, __ATOMIC_ACQUIRE),
+              __atomic_load_n(&d->wait_seq, __ATOMIC_ACQUIRE),
+              __atomic_load_n(&d->reset_mark, __ATOMIC_ACQUIRE));
+   }
+}
+
 static VkResult
 sync_wait_impl(struct nvkmd_nvrm_dev *dev,
                uint32_t wait_count,
@@ -573,6 +607,8 @@ sync_wait_impl(struct nvkmd_nvrm_dev *dev,
    int evFd = can_event ? sync_event_acquire(dev, &hEvent) : -1;
 
    VkResult result;
+   const uint64_t wait_start = os_time_get_nano();
+   uint64_t next_report = wait_start + STUCK_FIRST_NS;
    for (;;) {
       if (sync_wait_satisfied(waits, wait_count, wait_flags)) {
          result = VK_SUCCESS;
@@ -584,6 +620,11 @@ sync_wait_impl(struct nvkmd_nvrm_dev *dev,
          result = VK_TIMEOUT;
          break;
       }
+      if ((uint64_t)now >= next_report) {
+         sync_wait_report_stuck(waits, wait_count, wait_flags,
+                                (uint64_t)now - wait_start);
+         next_report = (uint64_t)now + STUCK_EVERY_NS;
+      }
 
       /* Unsigned, so a near-UINT64_MAX (effectively infinite) timeout doesn't
        * overflow into a negative span and collapse the wait into a tight spin;
-- 
2.43.0

