diff --git a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm.h b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm.h
index 739faa8..a47a89b 100644
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm.h
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm.h
@@ -166,7 +166,29 @@ VkResult nvkmd_nvrm_alloc_va(struct nvkmd_dev *dev,
  * non-blocking slot recycling, the RC-error notifier and an OS wake event.
  * Built by nvrm_channel_init(); both contexts emit host SEM acquire/release +
  * non-stall interrupt methods into it and submit via the same helpers. */
+/* Diagnostics only: the most recent host semaphore methods emitted on a
+ * channel, so a CPU wait that stalls can say what the GPU is parked on (see
+ * nvkmd_nvrm_channel_report). Written and read under dev->sync_mutex. */
+#define NVRM_CHAN_SEM_LOG 16
+
+struct nvkmd_nvrm_sem_record {
+   /* CPU view of the 64-bit payload, or NULL if there is none. Only read
+    * while fence > the channel's completed fence: until then the backing
+    * memory stays allocated (pool pages live until device teardown, and
+    * freed sync memory is retired only past the channel's work). */
+   const volatile uint64_t *word;
+   uint64_t addr;   /* GPU VA of the payload */
+   uint64_t value;  /* acquire: waits for payload >= value; release: writes it */
+   uint64_t fence;  /* channel fence (wSeq) of the submit cycle carrying it */
+};
+
 struct nvkmd_nvrm_channel {
+   struct nvkmd_nvrm_dev *dev;
+   const char *kind;  /* "exec", "copy" or "bind", for diagnostics */
+   struct nvkmd_nvrm_sem_record acqLog[NVRM_CHAN_SEM_LOG];
+   struct nvkmd_nvrm_sem_record relLog[NVRM_CHAN_SEM_LOG];
+   uint32_t acqLogNext;
+   uint32_t relLogNext;
    struct nvkmd_mem *notifier;
    struct nvkmd_mem *userD;
    struct nvkmd_mem *gpFifo;
@@ -216,6 +238,7 @@ struct NvRmSemSurf;
 /* One queued semaphore acquire (wait) or release (signal) on the bind channel,
  * captured at wait()/signal() time and emitted in flush(). */
 struct nvkmd_nvrm_bind_sem {
+   const volatile uint64_t *word;  /* CPU view, for diagnostics */
    uint64_t addr;
    uint64_t value;
 };
@@ -302,6 +325,9 @@ void nvkmd_nvrm_sync_unregister_channel(struct nvkmd_nvrm_dev *dev,
 /* The channel fence it has completed, and the fence by which it will have
  * executed everything emitted so far (submitted or still in its push). */
 uint64_t nvkmd_nvrm_channel_completed(const struct nvkmd_nvrm_channel *chan);
+uint32_t nvkmd_nvrm_channel_rc_status(const struct nvkmd_nvrm_channel *chan);
+void nvkmd_nvrm_channel_report(const struct nvkmd_nvrm_channel *chan);
+const volatile uint64_t *nvkmd_nvrm_sync_cpu_word(struct vk_sync *sync);
 uint64_t nvkmd_nvrm_channel_retire_point(const struct nvkmd_nvrm_channel *chan);
 uint64_t nvkmd_nvrm_sync_gpu_signal_value(struct vk_sync *sync, uint64_t value);
 uint64_t nvkmd_nvrm_sync_gpu_wait_value(struct vk_sync *sync, uint64_t value);
diff --git a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_ctx.c b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_ctx.c
index 8ad5e5a..cc34d68 100644
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_ctx.c
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_ctx.c
@@ -95,6 +95,95 @@ chan_check_error(struct nvkmd_nvrm_channel *chan)
 	return notifiers[NV906F_NOTIFIERS_RC].status != 0;
 }
 
+/* RM's robust-channel error status for the channel: 0 while it is healthy.
+ * A channel with an RC error has stopped executing for good. */
+uint32_t
+nvkmd_nvrm_channel_rc_status(const struct nvkmd_nvrm_channel *chan)
+{
+	const volatile NvNotification *notifiers = chan->notifier->map;
+	return notifiers[NV906F_NOTIFIERS_RC].status;
+}
+
+/* Record a host semaphore method for nvkmd_nvrm_channel_report(). Methods
+ * written now belong to the current submit cycle, which nvrm_channel_submit
+ * retires with fence wSeq + 1. */
+static void
+chan_log_sem(struct nvkmd_nvrm_channel *chan, bool acquire,
+             const volatile uint64_t *word, uint64_t addr, uint64_t value)
+{
+	struct nvkmd_nvrm_sem_record rec = {
+		.word = word,
+		.addr = addr,
+		.value = value,
+		.fence = chan->wSeq + 1,
+	};
+	simple_mtx_lock(&chan->dev->sync_mutex);
+	if (acquire)
+		chan->acqLog[chan->acqLogNext++ % NVRM_CHAN_SEM_LOG] = rec;
+	else
+		chan->relLog[chan->relLogNext++ % NVRM_CHAN_SEM_LOG] = rec;
+	simple_mtx_unlock(&chan->dev->sync_mutex);
+}
+
+static void
+chan_report_sem_log(const struct nvkmd_nvrm_channel *chan, bool acquire,
+                    uint64_t completed)
+{
+	const struct nvkmd_nvrm_sem_record *recs =
+		acquire ? chan->acqLog : chan->relLog;
+	uint32_t next = acquire ? chan->acqLogNext : chan->relLogNext;
+	/* Every acquire still pending (the oldest is the one the host is parked
+	 * on), but only the latest releases. */
+	uint32_t count = MIN2(next, acquire ? NVRM_CHAN_SEM_LOG : 6);
+
+	for (uint32_t n = count; n > 0; n--) {
+		const struct nvkmd_nvrm_sem_record *r =
+			&recs[(next - n) % NVRM_CHAN_SEM_LOG];
+		bool done = r->fence <= completed;
+		if (acquire && done)
+			continue;  /* only acquires the GPU may still be parked on */
+
+		if (!done && r->word != NULL) {
+			uint64_t now = *r->word;
+			fprintf(stderr, "nvk/nvrm:     %s 0x%" PRIx64 " %s %" PRIu64
+			        " (now %" PRIu64 "%s), fence %" PRIu64 ", pending\n",
+			        acquire ? "acquire" : "release", r->addr,
+			        acquire ? ">=" : "=", r->value, now,
+			        acquire ? (now >= r->value ? ", satisfied"
+			                                   : ", NOT satisfied") : "",
+			        r->fence);
+		} else {
+			fprintf(stderr, "nvk/nvrm:     %s 0x%" PRIx64 " %s %" PRIu64
+			        ", fence %" PRIu64 ", %s\n",
+			        acquire ? "acquire" : "release", r->addr,
+			        acquire ? ">=" : "=", r->value, r->fence,
+			        done ? "done" : "pending");
+		}
+	}
+}
+
+/* Print the channel's state and its recent semaphore methods, for a CPU wait
+ * that has stalled (nvkmd_nvrm_sync.c). Caller holds dev->sync_mutex. */
+void
+nvkmd_nvrm_channel_report(const struct nvkmd_nvrm_channel *chan)
+{
+	const KeplerBControlGPFifo *userD = chan->userD->map;
+	uint64_t completed = nvkmd_nvrm_channel_completed(chan);
+	uint32_t rc = nvkmd_nvrm_channel_rc_status(chan);
+
+	fprintf(stderr, "nvk/nvrm:   %s channel %p: completed fence %" PRIu64
+	        " of %" PRIu64 " submitted, GPGet %u GPPut %u%s",
+	        chan->kind ? chan->kind : "?", (const void *)chan, completed,
+	        chan->wSeq, (unsigned)userD->GPGet, (unsigned)userD->GPPut,
+	        completed >= chan->wSeq ? ", idle" : "");
+	if (rc != 0)
+		fprintf(stderr, ", RC ERROR status 0x%x (channel stopped)", rc);
+	fprintf(stderr, "\n");
+
+	chan_report_sem_log(chan, true, completed);
+	chan_report_sem_log(chan, false, completed);
+}
