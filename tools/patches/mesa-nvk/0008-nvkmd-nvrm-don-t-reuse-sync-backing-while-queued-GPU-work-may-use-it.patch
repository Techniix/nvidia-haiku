 .../vulkan/nvkmd/nvrm/nvkmd_nvrm_retire.h     | 113 ++++++++++
 .../vulkan/nvkmd/nvrm/nvkmd_nvrm_sync.c       | 196 ++++++++++++++++--
 5 files changed, 350 insertions(+), 17 deletions(-)
 create mode 100644 src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_retire.h

