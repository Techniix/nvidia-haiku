@@ -981,7 +981,7 @@ RemoteDrawingEngine::StringWidth(const char* string, int32 length,
 
 status_t
 RemoteDrawingEngine::ReadBitmap(ServerBitmap* bitmap, bool drawCursor,
-	BRect bounds)
+	BRect bounds, const BRegion* frontBufferRegion)
 {
 	if (_AddCallback() != B_OK)
 		return B_UNSUPPORTED;
