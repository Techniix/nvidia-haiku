@@ -169,10 +169,6 @@ public:
 			bool				HideFloatingOverlays();
 			void				ShowFloatingOverlays();
 
-	// The frame buffer area the software cursor is currently drawn on (it is
-	// not in the back buffer), or an invalid rect if there is none.
-			BRect				SoftwareCursorFrame() const;
-
 	// Listener support
